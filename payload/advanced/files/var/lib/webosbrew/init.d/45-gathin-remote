#!/bin/sh
[ -f /home/root/DISABLE-GATHIN-REMOTE ] && exit 0
ROOT=/var/lib/webosbrew/gathin-remote
if [ -f "$ROOT/server.pid" ]; then
 pid=$(cat "$ROOT/server.pid")
 case "$pid" in ''|*[!0-9]*) pid=invalid;; esac
 if [ -r "/proc/$pid/cmdline" ] && tr '\000' ' ' < "/proc/$pid/cmdline" | grep -F "$ROOT/server.js" >/dev/null; then exit 0; fi
fi
/usr/bin/node "$ROOT/server.js" >>/tmp/gathin-tv-remote.log 2>&1 </dev/null &
echo $! > "$ROOT/server.pid"
